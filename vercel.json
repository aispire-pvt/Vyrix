{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/waitlist.js": {
      "memory": 256
    }
  },
  "rewrites": [
    {
      "source": "/upes",
      "destination": "https://vyrix-upes.vercel.app/"
    },
    {
      "source": "/upes/:path*",
      "destination": "https://vyrix-upes.vercel.app/:path*"
    }
  ]
}
