{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/waitlist.js": {
      "memory": 256
    }
  },
  "rewrites": [
    {
      "source": "/upes",
      "destination": "https://vyrix-five.vercel.app/downloads-upes"
    },
    {
      "source": "/upes/:path*",
      "destination": "https://vyrix-five.vercel.app/downloads-upes/:path*"
    }
  ]
}
