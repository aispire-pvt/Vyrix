# Set this when the production waitlist backend is ready.
# Leave blank to use the local Next.js route at /api/waitlist.
NEXT_PUBLIC_WAITLIST_API_URL=

# Direct download links for desktop builds (configured in .env.local or deployment environment)
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=
NEXT_PUBLIC_MAC_DOWNLOAD_URL=

# Installation guide links (PDF)
NEXT_PUBLIC_WINDOWS_INSTALL_GUIDE_URL=
NEXT_PUBLIC_MAC_INSTALL_GUIDE_URL=

